# Ignore the entire output directory
output/

# Ignore any files ending in .o (object files)
*.o

# Ignore common executable extensions
*.out
*.exe

# Ignore Mac system files
.DS_Store# --- VS Code Files ---
.vscode/
*.code-workspace

# --- Compilation & Build Outputs ---
# Ignores your specific output folders
output/
c/output/
bin/
build/

# Ignores all executable files (even without extensions)
*.exe
*.out
*.app

# --- Debugging Artifacts ---
# macOS creates .dSYM folders when you use the -g flag for debugging
*.dSYM/
*.pdb
*.ilk

# --- Intermediate Object Files ---
*.o
*.obj

# --- System Junk ---
.DS_Store
