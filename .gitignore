# IDEs
.idea/
.vscode/

# MacOS noise
.DS_Store
**/.DS_Store

# C/C++ build artifacts
*.dSYM/
*.o
*.out
*.pch
output/
**/*.dSYM/
**/output/

# Python
__pycache__/
*.pyc

# Personal configs
a.gitconfig
# 1. קודם כל, תתעלם מהכל
*

# 2. אל תתעלם מתיקיות (כדי שנוכל להיכנס פנימה)
!*/

# 3. אל תתעלם מקבצי קוד ומסמכים
!*.c
!*.h
!*.py
!*.md
!*.txt
!.gitignore
!Makefile

# 4. תתעלם ספציפית מדברים שבכל זאת לא נרצה (כמו קבצי זמניים של פייתון)
**/__pycache__/
.DS_Store
